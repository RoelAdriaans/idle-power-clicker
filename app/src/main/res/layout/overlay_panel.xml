<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating overlay panel that appears on top of the game.
    Draggable by touching anywhere on the panel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/overlayBackground"
    android:orientation="vertical"
    android:padding="10dp"
    android:elevation="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="⚡ IPH"
        android:textColor="@color/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Start / Stop toggle -->
    <Button
        android:id="@+id/btn_start_stop"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="▶ Start"
        android:textSize="12sp" />

    <!-- Shown while idle: speed selector + debug + close -->
    <LinearLayout
        android:id="@+id/layout_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Speed selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Speed"
            android:textColor="@color/textLight"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/rg_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_slow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slow (1.5s)"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/rb_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Normal (0.8s)"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/rb_fast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast (0.35s)"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </RadioGroup>

        <!-- Status text -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:gravity="center"
            android:text="Idle"
            android:textColor="@color/textLight"
            android:textSize="10sp" />

        <!-- Toggle grid debug overlay -->
        <Button
            android:id="@+id/btn_debug"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="🔍 Debug"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Shown while running: move progress + ETA -->
    <LinearLayout
        android:id="@+id/layout_running"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_move_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_moves_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textColor="@color/textLight"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_eta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textColor="#AAFFAA"
            android:textSize="10sp" />

    </LinearLayout>

    <!--
        Grid adjustment controls — only visible when debug mode is ON.
        Each row nudges one edge of the grid inward (▲/▶/▼/◄) or outward.
        Step size buttons change how many pixels each tap moves.
    -->
    <LinearLayout
        android:id="@+id/layout_grid_adjust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#55FFFFFF" />

        <!-- Move entire grid (preserves size) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Move grid"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">
            <Button
                android:id="@+id/btn_move_up"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="↑"
                android:textSize="14sp"
                android:padding="0dp"/>
            <Button
                android:id="@+id/btn_move_down"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="↓"
                android:textSize="14sp"
                android:padding="0dp"/>
            <Button
                android:id="@+id/btn_move_left"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="←"
                android:textSize="14sp"
                android:padding="0dp"/>
            <Button
                android:id="@+id/btn_move_right"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="→"
                android:textSize="14sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Grid edges"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>

        <!-- Top edge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="Top"
                android:textColor="@color/textLight"
                android:textSize="10sp"/>
            <Button
                android:id="@+id/btn_top_up"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="↑"
                android:textSize="12sp"
                android:padding="0dp"/>
            <Button
                android:id="@+id/btn_top_down"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="↓"
                android:textSize="12sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- Bottom edge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="Bot"
                android:textColor="@color/textLight"
                android:textSize="10sp"/>
            <Button
                android:id="@+id/btn_bot_up"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="↑"
                android:textSize="12sp"
                android:padding="0dp"/>
            <Button
                android:id="@+id/btn_bot_down"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="↓"
                android:textSize="12sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- Left edge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="Left"
                android:textColor="@color/textLight"
                android:textSize="10sp"/>
            <Button
                android:id="@+id/btn_left_in"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="→"
                android:textSize="12sp"
                android:padding="0dp"/>
            <Button
                android:id="@+id/btn_left_out"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="←"
                android:textSize="12sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- Right edge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="Right"
                android:textColor="@color/textLight"
                android:textSize="10sp"/>
            <Button
                android:id="@+id/btn_right_in"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="←"
                android:textSize="12sp"
                android:padding="0dp"/>
            <Button
                android:id="@+id/btn_right_out"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="→"
                android:textSize="12sp"
                android:padding="0dp"/>
        </LinearLayout>


        <!-- Save button -->
        <Button
            android:id="@+id/btn_save_grid_overlay"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="💾 Save"
            android:textSize="11sp"
            android:padding="0dp"
            android:layout_marginBottom="4dp"/>

    </LinearLayout>

    <!-- Stop service button — hidden while running -->
    <Button
        android:id="@+id/btn_close"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="✕ Close"
        android:textSize="11sp" />

</LinearLayout>
